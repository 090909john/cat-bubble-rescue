{
  "animals": {
    "bird":      { "e": "🐦", "zh": "小鳥", "en": "Bird", "fzh": "小鳥用翅膀飛，早上最喜歡唱歌。", "fen": "Birds fly with wings and love to sing in the morning." },
    "flower":    { "e": "🌸", "zh": "花朵", "en": "Flower", "fzh": "花朵喝水、曬太陽就會開花。", "fen": "Flowers bloom with water and sunshine." },
    "rabbit":    { "e": "🐰", "zh": "小兔子", "en": "Rabbit", "fzh": "兔子的耳朵長長的，很會跳。", "fen": "Rabbits have long ears and are great jumpers." },
    "squirrel":  { "e": "🐿️", "zh": "松鼠", "en": "Squirrel", "fzh": "松鼠會把堅果藏起來過冬。", "fen": "Squirrels hide nuts for winter." },
    "hedgehog":  { "e": "🦔", "zh": "刺蝟", "en": "Hedgehog", "fzh": "刺蝟害怕時會縮成一顆刺刺球。", "fen": "Hedgehogs roll into a spiky ball when scared." },
    "owl":       { "e": "🦉", "zh": "貓頭鷹", "en": "Owl", "fzh": "貓頭鷹晚上醒著，眼睛大大的。", "fen": "Owls are awake at night with big round eyes." },
    "butterfly": { "e": "🦋", "zh": "蝴蝶", "en": "Butterfly", "fzh": "蝴蝶小時候是毛毛蟲喔！", "fen": "A butterfly was a caterpillar when it was little!" },
    "fish":      { "e": "🐠", "zh": "小魚", "en": "Fish", "fzh": "小魚用鰓在水裡呼吸。", "fen": "Fish breathe in water with gills." },
    "crab":      { "e": "🦀", "zh": "螃蟹", "en": "Crab", "fzh": "螃蟹喜歡橫著走路。", "fen": "Crabs like to walk sideways." },
    "turtle":    { "e": "🐢", "zh": "海龜", "en": "Sea Turtle", "fzh": "海龜會回到沙灘生蛋。", "fen": "Sea turtles come back to the beach to lay eggs." },
    "seal":      { "e": "🦭", "zh": "海豹", "en": "Seal", "fzh": "海豹游泳很快，喜歡在岩石上曬太陽。", "fen": "Seals swim fast and nap on sunny rocks." },
    "bear":      { "e": "🐻", "zh": "台灣黑熊", "en": "Formosan Black Bear", "fzh": "胸前有白色的 V 字，像戴了一條月亮項鍊。", "fen": "It has a white V on its chest, like a moon necklace.", "visitor": true },
    "leopardcat":{ "e": "🐆", "zh": "石虎", "en": "Leopard Cat", "fzh": "台灣的小野貓，耳朵後面有白色斑點。", "fen": "A small wild cat of Taiwan with white spots behind its ears.", "visitor": true }
  },
