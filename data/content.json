  "story": [
    { "e": "🏘️🌈", "zh": "在雲朵上面，有一個好漂亮的天空小鎮。", "en": "Above the clouds there is a lovely Sky Town." },
    { "e": "⛈️😢", "zh": "可是大烏雲飄來了，小鳥、花朵和小動物都被困住，小鎮也變成灰色。", "en": "But a big dark cloud came. Friends got stuck and the town turned grey." },
    { "e": "🐱🫧", "zh": "貓咪小飛俠戴上護目鏡，背起噴射背包，用彩虹泡泡去救大家！", "en": "Cat Jet Hero puts on goggles and a jetpack to rescue everyone with rainbow bubbles!" },
    { "e": "👆✨", "zh": "用一根手指拖著貓咪飛，泡泡會自己吹出來喔！", "en": "Drag the cat with one finger. Bubbles come out by themselves!" }
  ],
